# Logging
JARVIS_LOG_LEVEL=INFO

# Audio input. Leave empty to use the system default input device.
# On Raspberry Pi/ALSA this can be a sounddevice-compatible device id/name.
JARVIS_AUDIO_DEVICE=
JARVIS_SAMPLE_RATE=16000
JARVIS_CHANNELS=1
JARVIS_CHUNK_SIZE=1280

# Wake word
JARVIS_WAKEWORD_MODEL=hey_jarvis
JARVIS_WAKEWORD_THRESHOLD=0.5
JARVIS_WAKEWORD_COOLDOWN_MS=1500
